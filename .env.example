PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:43127

MONGO_URI=mongodb://localhost:27017
MONGODB_DATABASE=EFCore

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=your-desktop-client-secret

# Limite de almacenamiento de MongoDB para calcular el porcentaje de uso en /api/admin/system.
# Déjalo sin definir si tu proveedor no publica un límite fijo.
STORAGE_LIMIT_BYTES=
